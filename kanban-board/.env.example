STITCH_API_KEY=

# --- Docker Compose (optional) ---------------------------------------------------------------
# Used only by `docker compose` to fill in compose.yaml. Compose reads this file for variable
# interpolation and never passes it into a container. Every value below is the default, so you
# only need to uncomment what you want to change.

# Host port of the app (http://localhost:<port>).
# KANBAN_PORT=8080
# Host interface the port binds to. 0.0.0.0 lets other devices on your network reach the app,
# which has NO login.
# KANBAN_BIND_ADDRESS=127.0.0.1
# Seed the "Sample Project" board when the store is empty.
# KANBAN_SEED_ON_STARTUP=true
# Extra allowed cross-origin addresses, comma-separated. Not needed for the default setup; '*' is rejected.
# KANBAN_CORS_ORIGINS=
# Backend database location (inside the kanban-data volume).
# KANBAN_DATABASE_URL=sqlite:////data/kanban.db
# Where nginx forwards /api/, /docs and /openapi.json (scheme://host:port, no path).
# KANBAN_BACKEND_UPSTREAM=http://backend:8000
# Tag of the locally built images (kanban-backend, kanban-frontend, kanban-e2e).
# KANBAN_IMAGE_TAG=local
