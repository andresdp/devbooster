# Routes for the single app address (specs/004-containerize-app/contracts/http-routing.md).
# Only ${BACKEND_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS} are substituted at container start
# (NGINX_ENVSUBST_FILTER); every other $ is an nginx variable.
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    # Re-resolve the backend name at request time with the container's own DNS server
    # (NGINX_LOCAL_RESOLVERS is read from /etc/resolv.conf by the image entrypoint). A fixed
    # proxy_pass host is resolved once at start, so a backend that comes back with a new IP
    # (e.g. after `docker compose stop backend` + `up`) would stay unreachable.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
    set $backend_upstream ${BACKEND_UPSTREAM};

    # Fail fast when the backend is gone: connecting to a stopped container's old IP hangs
    # until this timeout (nginx default 60s) instead of being refused.
    proxy_connect_timeout 3s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API: proxied unchanged (an upstream without a path passes the original URI and query).
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_intercept_errors off;
        error_page 502 503 504 = @api_unavailable;
    }

    # Backend down or unreachable: answer with the API's uniform JSON error.
    location @api_unavailable {
        default_type application/json;
        return 503 '{"error":{"code":"service_unavailable","message":"The API is temporarily unavailable.","details":null}}';
    }

    # API docs generated by FastAPI.
    location = /docs {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /docs/oauth2-redirect {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /openapi.json {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite output has hashed file names, so it can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes fall back to index.html, which is never cached.
    location / {
        try_files $uri /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
